{
  "name": "pdfmaid",
  "version": "2.0.0",
  "description": "Markdown to PDF/HTML converter with Mermaid diagrams and offline, self-contained output",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pdfmaid": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "pdfmaid",
    "markdown",
    "pdf",
    "html",
    "mermaid",
    "diagrams",
    "converter",
    "cli"
  ],
  "author": "Lyuboslav Petrov <petrov.lyuboslav@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirabo/pdfmaid.git"
  },
  "bugs": {
    "url": "https://github.com/nirabo/pdfmaid/issues"
  },
  "homepage": "https://github.com/nirabo/pdfmaid#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
